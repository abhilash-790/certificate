{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MarksheetCertificateSchema",
  "type": "object",
  "required": [
    "holder_name",
    "institution",
    "certificate_number",
    "semester_or_year",
    "subjects",
    "total_obtained",
    "total_max",
    "result_status",
    "issue_date"
  ],
  "properties": {
    "holder_name": {
      "type": "string",
      "description": "Full name of student"
    },
    "institution": {
      "type": "string",
      "description": "Name of university or board"
    },
    "certificate_number": {
      "type": "string",
      "description": "Roll number or marksheet serial number"
    },
    "semester_or_year": {
      "type": "string",
      "description": "Semester / academic year (e.g. Semester VIII / Final Year)"
    },
    "exam_session": {
      "type": "string",
      "description": "Examination period (e.g. May-June 2025)"
    },
    "subjects": {
      "type": "array",
      "description": "List of subject mark breakdowns",
      "items": {
        "type": "object",
        "required": ["subject_name", "max_marks", "obtained_marks"],
        "properties": {
          "subject_code": { "type": "string" },
          "subject_name": { "type": "string" },
          "max_marks": { "type": "number" },
          "obtained_marks": { "type": "number" },
          "grade": { "type": "string" }
        }
      }
    },
    "total_obtained": {
      "type": "number",
      "description": "Sum total of marks obtained across subjects"
    },
    "total_max": {
      "type": "number",
      "description": "Maximum possible total marks"
    },
    "percentage": {
      "type": "number",
      "description": "Calculated percentage"
    },
    "cgpa": {
      "type": "number",
      "description": "Grade Point Average or CGPA"
    },
    "result_status": {
      "type": "string",
      "description": "Final result status (PASS / FAIL / PROMOTED)"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Date of publication / issue in YYYY-MM-DD format"
    }
  }
}
