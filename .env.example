# CertiGuard System Environment Configuration

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_super_secret_key_in_production_min_32_chars_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (PostgreSQL)
POSTGRES_USER=certiguard
POSTGRES_PASSWORD=certiguard_secure_pass_2026
POSTGRES_DB=certiguard_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://certiguard:certiguard_secure_pass_2026@localhost:5432/certiguard_db

# Redis & Celery Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Object Storage Configuration (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_key
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin_secure_key
S3_BUCKET_NAME=certiguard-files
S3_REGION=us-east-1

# LLM Adapter Configuration
LLM_PROVIDER=mock  # Options: mock, openai, anthropic, gemini
LLM_API_KEY=mock_api_key_value
LLM_MODEL_NAME=mock-vision-v1

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_ISSUER_DOMAINS=["iitb.ac.in","nptel.ac.in","coursera.org","udemy.com","certiguard.internal"]
